[Unit]
Description=Build and atomically publish a GearDrop data revision
After=network-online.target geardrop-deploy.service
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
Group=ec2-user
Environment=HOME=/home/ec2-user
ExecStart=/usr/local/libexec/geardrop-sync-data
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
ProtectHome=read-only
TimeoutStartSec=10min
